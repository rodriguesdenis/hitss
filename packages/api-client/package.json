{
  "name": "@hitss/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed Teams & Tasks API client generated by orval from the API's OpenAPI document",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./zod": "./src/generated/zod/index.ts"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "react": ">=19",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@hitss/tsconfig": "workspace:*",
    "@tanstack/react-query": "5.104.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "orval": "8.43.0",
    "react": "19.3.0",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  }
}
