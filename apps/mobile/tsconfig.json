{
  "extends": ["expo/tsconfig.base", "@hitss/tsconfig/base.json"],
  "compilerOptions": {
    "target": "ESNext",
    "allowImportingTsExtensions": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "nativewind-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
