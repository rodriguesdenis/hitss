// Teams & Tasks — PostgreSQL schema (ADR-0004, docs/architecture/data-model.md).
// The connection URL lives in prisma.config.ts (CLI) and AppConfig (runtime), never here.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Identity context (Better Auth, ADR-0007). Models follow `auth generate --adapter prisma`
// (better-auth 1.7) with snake_case table/column names. Deviation by design (D16): ids are `text`
// holding UUIDs, not `uuid`. With `generateId: 'uuid'` on PostgreSQL Better Auth omits the id on
// insert, so the database generates it (`gen_random_uuid()::text`). Other contexts reference
// `users.id` as an opaque text owner id.
// Raw-SQL checks appended to migration create_identity_tables (Prisma cannot express them):
// users_email_lowercase (email = lower(email)), users_name_length (1..100 chars),
// users_email_length (<= 254 chars).
// ---------------------------------------------------------------------------------------------

model User {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  teams         Team[]
  tasks         Task[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Sessions of a user: listing and cascade delete.
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // One account per provider identity (a credential account's id is the user id).
  @@unique([providerId, accountId])
  // Credential lookup at sign-in (by user) and cascade delete.
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Better Auth looks verifications up by identifier.
  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------------------------
// Team Management context (plan 002 § Data). Ids come from the domain's IdGenerator (no DB
// default); created_at/updated_at are set by the domain clock, not by Prisma. Soft delete via
// deleted_at (ADR-0016); version for optimistic concurrency (ADR-0015).
// Raw SQL in migration create_teams (Prisma cannot express it):
//   teams_owner_id_lower_name_key  UNIQUE (owner_id, lower(name)) WHERE deleted_at IS NULL
//   teams_owner_id_created_at_idx  (owner_id, created_at DESC, id DESC) WHERE deleted_at IS NULL
//   teams_color_hex_format         CHECK (color_hex ~ '^#[0-9A-F]{6}$')
//   teams_version_positive         CHECK (version >= 1)
//   teams_updated_after_created    CHECK (updated_at >= created_at)
// ---------------------------------------------------------------------------------------------

model Team {
  id          String     @id @db.Uuid
  ownerId     String     @map("owner_id")
  name        String     @db.VarChar(50)
  colorHex    String     @map("color_hex") @db.Char(7)
  description String?    @db.VarChar(280)
  version     Int        @default(1)
  createdAt   DateTime   @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(3)
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  taskTeams   TaskTeam[]

  @@map("teams")
}

// ---------------------------------------------------------------------------------------------
// Task Management context (plan 003 § Data, data model). Ids come from the domain's IdGenerator;
// created_at/updated_at come from the domain clock (no DB default, no @updatedAt, as for Team);
// the repository bumps version (V-1).
// Raw SQL in migration create_tasks (Prisma cannot express it):
//   pg_trgm extension (top of the migration; the GIN index below needs it)
//   tasks_owner_status_created_idx  (owner_id, status, created_at DESC, id DESC) WHERE deleted_at IS NULL
//   tasks_owner_created_idx         (owner_id, created_at DESC, id DESC)         WHERE deleted_at IS NULL
//   tasks_owner_due_idx             (owner_id, due_date, id)                     WHERE deleted_at IS NULL
//   tasks_title_len                 CHECK (char_length(title) BETWEEN 3 AND 120)
//   tasks_version_pos               CHECK (version >= 1)
//   tasks_completed_done            CHECK ((status = 'DONE') = (completed_at IS NOT NULL))
//   tasks_updated_after_created     CHECK (updated_at >= created_at)
// ---------------------------------------------------------------------------------------------

/// Declaration order is the lifecycle order; the status sort relies on it.
enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE

  @@map("task_status")
}

model Task {
  id          String     @id @db.Uuid
  ownerId     String     @map("owner_id")
  title       String     @db.VarChar(120)
  description String?    @db.VarChar(2000)
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?  @map("due_date") @db.Date
  completedAt DateTime?  @map("completed_at") @db.Timestamptz(3)
  version     Int        @default(1)
  createdAt   DateTime   @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(3)
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teams       TaskTeam[]

  // search: ILIKE '%term%' on title OR description (BitmapOr), useful from 3 characters.
  // Declared here (not raw SQL) because Prisma introspects GIN indexes; needs pg_trgm, created
  // at the top of migration create_tasks.
  @@index([title(ops: raw("gin_trgm_ops")), description(ops: raw("gin_trgm_ops"))], type: Gin, map: "tasks_search_trgm_idx")
  @@map("tasks")
}

model TaskTeam {
  taskId    String   @map("task_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([taskId, teamId])
  // teamId filter (EXISTS) and per-team counts; the primary key serves per-task lookups.
  @@index([teamId, taskId])
  @@map("task_teams")
}
