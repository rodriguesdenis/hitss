meta {
  name: Sign up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sign-up/email
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno Evaluator",
    "email": "bruno-{{$timestamp}}@example.test",
    "password": "Evaluator@1234"
  }
}

assert {
  res.status: eq 200
  res.body.user.id: isString
}

docs {
  Creates a throwaway account (unique email per run) and signs it in.
}
