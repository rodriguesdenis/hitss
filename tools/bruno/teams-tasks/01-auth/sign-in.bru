meta {
  name: Sign in (demo user)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
  auth: none
}

headers {
  Origin: {{origin}}
}

body:json {
  {
    "email": "{{demoEmail}}",
    "password": "{{demoPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.user.email: eq {{demoEmail}}
}

script:post-response {
  // The signed session token travels in this header; later requests send it as a bearer token.
  bru.setVar("token", res.headers["set-auth-token"]);
}

tests {
  test("returns a token for the bearer header", function () {
    expect(bru.getVar("token")).to.be.a("string").and.not.empty;
  });
}

docs {
  The `Origin` header is required on the `/api/auth` calls once a session cookie is present (Bruno
  keeps cookies between requests): Better Auth checks the origin of cookie-carrying calls, and it must
  be one the API trusts (`BETTER_AUTH_URL`), hence the separate `origin` variable. The `/api/v1`
  requests authenticate with the bearer token only (ADR-0020); a cookie is never used there.
  Set the `demoPassword` secret of the `local` environment to the documented demo password
  (README) before running. The token is saved to the `token` variable.
}
