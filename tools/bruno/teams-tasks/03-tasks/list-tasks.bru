meta {
  name: List tasks
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/tasks?teamId={{teamId}}&status=PENDING,IN_PROGRESS&search=bruno&sort=dueDate&limit=10&offset=0
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.data: isArray
  res.body.meta.total: gte 1
  res.body.data[0].id: eq {{taskId}}
}

docs {
  Filters: `teamId`, `status` (comma-separated), `search`; sort by a field (`-` for descending) and
  offset pagination.
}
