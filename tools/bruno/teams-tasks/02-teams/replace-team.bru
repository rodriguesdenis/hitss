meta {
  name: Replace team
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/teams/{{teamId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "[bruno] Platform renamed {{$timestamp}}",
    "colorHex": "#0EA5E9",
    "description": "Replaced by the request collection."
  }
}

assert {
  res.status: eq 200
  res.body.data.colorHex: eq #0EA5E9
}

docs {
  Full replacement: an omitted description is cleared.
}
