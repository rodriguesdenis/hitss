meta {
  name: Create team
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/teams
  body: json
  auth: inherit
}

body:json {
  {
    "name": "[bruno] Platform {{$timestamp}}",
    "colorHex": "#10B981",
    "description": "Created by the request collection."
  }
}

assert {
  res.status: eq 201
  res.body.data.id: isString
  res.body.data.colorHex: eq #10B981
  res.body.data.taskCount: eq 0
  res.headers.location: contains /api/v1/teams/
}

script:post-response {
  bru.setVar("teamId", res.body.data.id);
}

docs {
  The team name starts with `[bruno]`; `98-cleanup` deletes it at the end of the run.
}
