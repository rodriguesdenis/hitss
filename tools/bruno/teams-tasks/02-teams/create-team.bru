meta {
  name: Create team
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/teams
  body: json
  auth: inherit
}

body:json {
  {
    "name": "[bruno] Platform {{$timestamp}}",
    "colorHex": "#10B981",
    "description": "Created by the request collection."
  }
}

assert {
  res.status: eq 201
  res.body.data.id: isString
  res.body.data.colorHex: eq #10B981
  res.headers.location: contains /api/v1/teams/
}

script:post-response {
  // Later requests of this run (and the clean-up) refer to the team by id.
  bru.setVar("teamId", res.body.data.id);
}

docs {
  The team name starts with `[bruno]`. The delete request that removes it lands with
  DELETE /api/v1/teams/:id (T-002-09).
}
