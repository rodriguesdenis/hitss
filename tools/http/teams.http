# Teams requests (VS Code REST Client / JetBrains HTTP Client). Run top to bottom.
@baseUrl = http://localhost:3000
@demoEmail = demo@teams-tasks.dev
# The documented demo password (README); the seed creates this account.
@demoPassword = Demo@1234

### Sign in (demo user)
# @name signIn
POST {{baseUrl}}/api/auth/sign-in/email
Origin: {{baseUrl}}
Content-Type: application/json

{
  "email": "{{demoEmail}}",
  "password": "{{demoPassword}}"
}

### Create team
# @name createTeam
POST {{baseUrl}}/api/v1/teams
Authorization: Bearer {{signIn.response.headers.set-auth-token}}
Content-Type: application/json

{
  "name": "[http] Platform {{$timestamp}}",
  "colorHex": "#10B981",
  "description": "Created by the request files."
}

### List teams
GET {{baseUrl}}/api/v1/teams?search=http&sort=-createdAt&limit=10&offset=0
Authorization: Bearer {{signIn.response.headers.set-auth-token}}

### Get team
GET {{baseUrl}}/api/v1/teams/{{createTeam.response.body.data.id}}
Authorization: Bearer {{signIn.response.headers.set-auth-token}}

### Replace team
PUT {{baseUrl}}/api/v1/teams/{{createTeam.response.body.data.id}}
Authorization: Bearer {{signIn.response.headers.set-auth-token}}
Content-Type: application/json

{
  "name": "[http] Platform renamed {{$timestamp}}",
  "colorHex": "#0EA5E9",
  "description": "Replaced by the request files."
}

### Delete team
DELETE {{baseUrl}}/api/v1/teams/{{createTeam.response.body.data.id}}
Authorization: Bearer {{signIn.response.headers.set-auth-token}}

### Get deleted team
GET {{baseUrl}}/api/v1/teams/{{createTeam.response.body.data.id}}
Authorization: Bearer {{signIn.response.headers.set-auth-token}}
