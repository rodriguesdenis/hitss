# Auth requests (VS Code REST Client / JetBrains HTTP Client).
# Run the sign-in request first; the token is reused below.
@baseUrl = http://localhost:3000
@demoEmail = demo@teams-tasks.dev
# The documented demo password (README); the seed creates this account.
@demoPassword = Demo@1234

### Sign up
POST {{baseUrl}}/api/auth/sign-up/email
Origin: {{baseUrl}}
Content-Type: application/json

{
  "name": "Http Evaluator",
  "email": "http-{{$timestamp}}@example.test",
  "password": "Evaluator@1234"
}

### Sign in (demo user)
# @name signIn
POST {{baseUrl}}/api/auth/sign-in/email
Origin: {{baseUrl}}
Content-Type: application/json

{
  "email": "{{demoEmail}}",
  "password": "{{demoPassword}}"
}

###
@token = {{signIn.response.headers.set-auth-token}}

### Get session
GET {{baseUrl}}/api/auth/get-session
Authorization: Bearer {{token}}

### Sign out
POST {{baseUrl}}/api/auth/sign-out
Origin: {{baseUrl}}
Authorization: Bearer {{token}}
