{
  "name": "hitss",
  "private": true,
  "description": "Teams & Tasks — fullstack monorepo (NestJS API + Expo mobile app)",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "guard:env": "node tools/ci/no-tracked-env.mjs",
    "arch": "turbo run arch test:arch",
    "doc-check": "node tools/ci/doc-check.mjs",
    "traceability": "node tools/ci/traceability.mjs --write",
    "traceability:check": "node tools/ci/traceability.mjs --require-tests"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
