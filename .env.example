# Copy to .env (`cp .env.example .env`) to override defaults. .env is gitignored — never commit it.
# Every value below is a safe, local-only placeholder and equals the default built into
# docker-compose.yml, so the stack also starts without a .env. Change them for anything non-local.

# PostgreSQL superuser name.
POSTGRES_USER=teams
# PostgreSQL password (local placeholder only).
POSTGRES_PASSWORD=teams-local-only
# Database created on first start.
POSTGRES_DB=teams_tasks
# Host interface for the published DB port; keep 127.0.0.1 — the phone talks to the API, never to the DB.
POSTGRES_BIND=127.0.0.1
# Host port published for PostgreSQL; use e.g. 5433 if 5432 is taken.
POSTGRES_PORT=5432

# ---- API (apps/api) — validated at start-up by src/config; an invalid value stops the API naming the variable.

# Application environment: local | test | production. Not NODE_ENV (that stays "production" in the Docker image).
# production adds extra rules, e.g. the placeholder secret below is refused.
APP_ENV=local
# HTTP port the API listens on (1-65535).
PORT=3000
# PostgreSQL connection URL for the API running on the host (docker compose builds its own from POSTGRES_*).
# The password is the local placeholder from POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://teams:teams-local-only@localhost:5432/teams_tasks
# Better Auth signing secret, at least 32 characters. Local placeholder only: APP_ENV=production refuses it,
# so generate a real one for any non-local use (e.g. `openssl rand -base64 48`) and keep it only in .env.
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
# Log level: fatal | error | warn | info | debug | trace | silent. APP_ENV=production refuses debug and trace.
LOG_LEVEL=info
# true prints human-readable logs (development only).
LOG_PRETTY=false
# true disables all OpenTelemetry export.
OTEL_SDK_DISABLED=false
# Service name reported in traces and metrics.
OTEL_SERVICE_NAME=teams-tasks-api
# OTLP/HTTP collector endpoint; spans are dropped silently when nothing listens. Must be https in
# production (except the compose-internal signoz-otel-collector). Only the OTEL_* variables listed here
# are supported: per-signal endpoints/protocols and OTEL_*_EXPORTER are rejected at start-up.
# OTEL_EXPORTER_OTLP_HEADERS (auth for a hosted backend) may be set in .env only; it is never logged.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTLP protocol: http/protobuf | http/json.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Resource attributes attached to all telemetry (comma-separated key=value).
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# Trace sampler: always_on | always_off | traceidratio | parentbased_always_on | parentbased_always_off | parentbased_traceidratio.
OTEL_TRACES_SAMPLER=parentbased_always_on
# Maximum requests per minute per authenticated user (positive integer).
RATE_LIMIT_MAX=100
# true runs the seed step when the API container starts.
SEED_ON_START=true
