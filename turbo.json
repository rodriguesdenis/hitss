{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "cacheDir": ".turbo/cache",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "arch": {
      "inputs": [
        "src/**",
        ".dependency-cruiser.cjs",
        "tsconfig*.json",
        "package.json"
      ]
    },
    "test:arch": {
      "inputs": [
        "src/**",
        "test/architecture/**",
        ".dependency-cruiser.cjs",
        "package.json"
      ]
    }
  }
}
