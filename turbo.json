{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "cacheDir": ".turbo/cache",
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "generate": {
      "inputs": ["prisma/**", "prisma.config.ts", "src/config/env-files.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    },
    "arch": {
      "dependsOn": ["generate"],
      "inputs": [
        "src/**",
        ".dependency-cruiser.cjs",
        "tsconfig*.json",
        "package.json"
      ]
    },
    "test:arch": {
      "dependsOn": ["generate"],
      "inputs": [
        "src/**",
        "test/architecture/**",
        ".dependency-cruiser.cjs",
        "package.json"
      ]
    }
  }
}
